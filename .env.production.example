# ==============================================================================
# KV TOURS & TRAVELS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: This is a placeholder template for production deployment.
# NEVER commit real production values, credentials, or secrets to Git.
# Set these variables securely in your deployment host environment:
#   - Backend: Render Environment Variables / Secret Manager
#   - Frontend: Vercel Project Environment Variables
#   - Database: Supabase Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# Backend Application Host
BACKEND_URL=https://api.kvtours.in

# Frontend Public Host (used for CORS and redirect resolution)
FRONTEND_URL=https://kvtours.in
FRONTEND_ORIGINS=https://kvtours.in,https://www.kvtours.in

# Cryptographic Secret Key (Generate with: openssl rand -hex 32)
# CRITICAL: Must be at least 32 characters long.
SECRET_KEY=replace-with-a-secure-64-char-hex-production-secret-key

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.your-supabase-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SESSIONS & COOKIES
# ------------------------------------------------------------------------------
AUTH_COOKIE_NAME=travel_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=.kvtours.in
AUTH_COOKIE_PATH=/
SESSION_MAX_AGE_SECONDS=604800

PASSWORD_RESET_EXPIRY=15

# CSRF Cookie Protection
CSRF_COOKIE_NAME=travel_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING
# ------------------------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PAYMENT_RATE_LIMIT_MAX_ATTEMPTS=10
PAYMENT_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (PRODUCTION LIVE KEYS)
# ------------------------------------------------------------------------------
# Production Key ID begins with "rzp_live_"
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
# Production Key Secret generated from Razorpay Dashboard -> API Keys
RAZORPAY_KEY_SECRET=your_production_key_secret
# Webhook Secret configured in Razorpay Dashboard -> Webhooks -> Secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_signing_secret
# Required 32-byte Base64 AES-256-GCM encryption key for database-backed payment credentials
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=your_32_byte_base64_master_encryption_key

# ------------------------------------------------------------------------------
# 6. EMAIL SERVICE (RESEND / SMTP)
# ------------------------------------------------------------------------------
# Resend API Key from resend.com/api-keys
RESEND_API_KEY=re_live_your_resend_api_key
# Verified sender domain in Resend
RESEND_FROM_EMAIL=concierge@kvtours.in

# SMTP Fallback (if not using Resend HTTP API)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your_resend_smtp_password
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS MESSAGING (META CLOUD API)
# ------------------------------------------------------------------------------
# Meta Cloud API credentials (leave blank to use verified Click-to-Chat fallback)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
# Business phone number (+91 with country code, no spaces or special characters)
WHATSAPP_PHONE_NUMBER=919442000000

# ------------------------------------------------------------------------------
# 8. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=kvtours_production

# ------------------------------------------------------------------------------
# 9. SENTRY MONITORING & APM
# ------------------------------------------------------------------------------
# Backend Sentry DSN
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# Frontend Sentry DSN (for Next.js client error boundary tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/your-frontend-project-id

# ------------------------------------------------------------------------------
# 10. FRONTEND CLIENT ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.kvtours.in/api/v1
NEXT_PUBLIC_SITE_URL=https://kvtours.in
NEXT_PUBLIC_BUSINESS_PHONE=+91 94420 00000
NEXT_PUBLIC_WHATSAPP_NUMBER=+919442000000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_production_key_id
