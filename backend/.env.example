APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/travelagency
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Authentication & Session Strategy
FIREBASE_PROJECT_ID=travel-agency-31216
AUTH_COOKIE_NAME=travel_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
SESSION_MAX_AGE_SECONDS=604800

# Password Recovery
PASSWORD_RESET_EXPIRY=15

# CSRF Protection
CSRF_COOKIE_NAME=travel_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 32-byte Base64 or Hex AES-256-GCM encryption key for database-stored payment gateway credentials
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=